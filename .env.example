# ─── ZK Privacy Transaction – Sepolia Config ───
# Copy file này thành .env và điền thông tin

# Sepolia RPC URL (Alchemy / Infura / public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key ví Sepolia (có ETH test để trả gas)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Địa chỉ smart contract Verifier đã deploy trên Sepolia
CONTRACT_ADDRESS=0x54ad8dff11d7043b7839ffc1646c5a0ae1eaf77f

# Block mà contract được deploy trên Sepolia (từ broadcast/run-latest.json: 0xa210d9 = 10625241)
# Dùng để bắt đầu paginate eth_getLogs, đặt nhỏ hơn vài block để an toàn
DEPLOY_BLOCK=10625000