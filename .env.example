# ─── ZK Privacy Transaction – Sepolia Config ───
# Copy file này thành .env và điền thông tin

# Sepolia RPC URL (Alchemy / Infura / public RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key ví Sepolia (có ETH test để trả gas)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Địa chỉ smart contract Verifier đã deploy trên Sepolia
CONTRACT_ADDRESS=0x54ad8dff11d7043b7839ffc1646c5a0ae1eaf77f

# Block mà contract được deploy trên Sepolia (từ broadcast/run-latest.json: 0xa210d9 = 10625241)
# Dùng để bắt đầu paginate eth_getLogs, đặt nhỏ hơn vài block để an toàn
DEPLOY_BLOCK=10625000

t dùng lệnh này sinh ra secret mới
$bytes = New-Object byte[] 32
$rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
$rng.GetBytes($bytes)
-join ($bytes | ForEach-Object { $_.ToString("x2") })
sec
0bfb62f21f20f4edfaa33fbfdfd6bdcd0da813046fc78fda3bc0823550ae7a12
com
0x2373d3954bff5a7885d6b59d91a16a2983a30160ffa5ce504a45280b6201ded1
///////////////////////////////////////////////////////////////////////

t dùng tiếp lệnh này do wsl không đọc được .env
RPC=$(grep '^SEPOLIA_RPC_URL=' .env | cut -d= -f2- | tr -d '\r')
PK=$(grep '^PRIVATE_KEY=' .env | cut -d= -f2- | tr -d '\r')

if [[ "$PK" != 0x* ]]; then
  PK="0x$PK"
fi

cast wallet address --private-key "$PK"

/////////////////////////////////////////////////////////////////////
sau đó t chạy lệnh này để gửi giao dịch deposit lên Sepolia
cast send 0xca65e2924751b2147258fb0c3a581632afa5ad01 \
  "deposit(bytes32)" \
  0x2373d3954bff5a7885d6b59d91a16a2983a30160ffa5ce504a45280b6201ded1 \
  --value 10000000000000000 \
  --rpc-url "$RPC" \
  --private-key "$PK"
/////////////////////////////////

sau đó thì t chạy lệnh này để gửi giao dịch transfer lên Sepolia
cargo run -p host -- --chain \
  --amount 10000000000000000 \
  --secret 0bfb62f21f20f4edfaa33fbfdfd6bdcd0da813046fc78fda3bc0823550ae7a12 \
  --recipient 0xf8329687322ADC276eDEA5cC25a6959Da1f5Dd7a \
  --groth16
